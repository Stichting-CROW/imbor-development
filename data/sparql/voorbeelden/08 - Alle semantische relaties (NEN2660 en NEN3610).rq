# Alle semantische relaties van álle objecttypen.
#
# In IMBOR zijn attributen én semantische relaties allebei RDF-properties, maar ze
# zijn iets verschillends:
#   - een ATTRIBUUT is een rdf:Property met een eigen prefLabel en een datatype of
#     waardenlijst (zie query 06/10);
#   - een SEMANTISCHE RELATIE legt een verband naar een andere klasse en gebruikt
#     als sh:path een generiek NEN2660/NEN3610-predicaat (nen2660:hasPart,
#     nen2660:isConnectedTo, nen2660:contains, nen2660:executes, nen2660:hasBoundary,
#     nen2660:isDescribedBy, nen3610:registratiegegevens, ...). Die predicaten zijn
#     GEEN rdf:Property in dit model.
#
# Deze query pakt daarom precies het spiegelbeeld van een attribuut: alle
# PropertyShapes waarvan de sh:path géén rdf:Property is. Zo komen alle semantische
# relaties mee (inclusief geometrie via hasBoundary en functie via executes; zie
# query 14 en 15 voor die twee apart). Voor alléén relaties naar een ander objecttype,
# zie query 09.
#
# Het doeltype staat in de sh:qualifiedValueShape via sh:class. De officiële
# NEN2660-relatielabels zitten niet in de Volledig-CombiGraph; daarom tonen we de
# lokale naam uit de URI (?relatiesoort) plus een informele NL-benaming (?relatieNL).
#
# Aanbevolen endpoint (IMBOR 2025):
#   https://hub.laces.tech/crow/imbor/2025/p/volledig-combigraph/sparql

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX dash: <http://datashapes.org/dash#>
PREFIX nen2660: <https://w3id.org/nen2660/def#>
PREFIX nen3610: <http://modellen.geostandaarden.nl/def/nen3610-2022#>

SELECT DISTINCT
  ?uriBron
  ?labelBron
  ?uriRelatie
  ?relatiesoort
  ?relatieNL
  ?uriDoeltype
  ?labelDoeltype
  ?labelMultipliciteit
WHERE {
  # Alle objecttypen als bron
  ?uriBron a rdfs:Class ;
           dash:abstract false ;
           skos:prefLabel ?labelBron ;
           rdfs:subClassOf* ?uriSuperklasse ;
           sh:property ?uriShape .
  FILTER(?uriSuperklasse IN (nen2660:SpatialRegion, nen2660:RealObject))

  # Semantische relatie = PropertyShape waarvan de sh:path GEEN rdf:Property is
  # (dat zijn juist de attributen). Zo blijft de volledige relatie-set over.
  ?uriShape sh:path ?uriRelatie .
  FILTER NOT EXISTS { ?uriRelatie a rdf:Property }

  # Relatiesoort = lokale naam uit de URI (bv. "hasPart")
  BIND(REPLACE(STR(?uriRelatie), "^.*[#/]", "") AS ?relatiesoort)

  # Informele NL-benaming (officiële NEN2660-termen zitten niet in de combigraph)
  OPTIONAL {
    VALUES (?uriRelatie ?relatieNL) {
      (nen2660:hasPart        "heeft deel")
      (nen2660:consistsOf     "bestaat uit")
      (nen2660:contains       "bevat")
      (nen2660:isConnectedTo  "is verbonden met")
      (nen2660:isDescribedBy  "wordt beschreven door")
      (nen2660:executes       "voert uit (functie)")
      (nen2660:hasBoundary    "heeft begrenzing (geometrie)")
      (nen3610:registratiegegevens "registratiegegevens")
    }
  }

  # Doeltype uit de qualified value shape (label uit URI als er geen prefLabel is,
  # bv. bij geometrieklassen als sf:Point)
  OPTIONAL {
    ?uriShape sh:qualifiedValueShape/sh:class ?uriDoeltype .
    OPTIONAL { ?uriDoeltype skos:prefLabel ?prefLabelDoel }
    BIND(COALESCE(?prefLabelDoel, REPLACE(STR(?uriDoeltype), "^.*[#/]", "")) AS ?labelDoeltype)
  }

  # Multipliciteit "min:max"
  OPTIONAL { ?uriShape sh:qualifiedMinCount ?qMin }
  OPTIONAL { ?uriShape sh:minCount ?min }
  OPTIONAL { ?uriShape sh:qualifiedMaxCount ?qMax }
  OPTIONAL { ?uriShape sh:maxCount ?max }
  BIND(COALESCE(?qMin, ?min) AS ?minC)
  BIND(COALESCE(?qMax, ?max) AS ?maxC)
  BIND(CONCAT(IF(BOUND(?minC), STR(?minC), "0"), ":",
              IF(BOUND(?maxC), STR(?maxC), "n")) AS ?labelMultipliciteit)
}
ORDER BY ?labelBron ?relatiesoort ?labelDoeltype
